# OpenTelemetry Configuration Example
# Copy this to .env or add these variables to your existing .env file

# Service identification
OTEL_SERVICE_NAME=seo-content-system
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development

# Export configuration
OTEL_ENABLE_CONSOLE=true
OTEL_ENABLE_PROMETHEUS=true

# OTLP Endpoint (for platforms like Jaeger, New Relic, etc.)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Jaeger Endpoint (for direct Jaeger export)
# OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Prometheus metrics port
OTEL_PROMETHEUS_PORT=9090

# Sampling configuration (1.0 = 100% sampling)
OTEL_TRACE_SAMPLE_RATE=1.0

# Example configurations for popular observability platforms:

# Jaeger (local)
# OTEL_EXPORTER_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# New Relic
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4317
# OTEL_EXPORTER_OTLP_HEADERS=api-key=YOUR_NEW_RELIC_LICENSE_KEY

# Honeycomb
# OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io:443
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_API_KEY

# Grafana Cloud
# OTEL_EXPORTER_OTLP_ENDPOINT=https://tempo-us-central1.grafana.net:443
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Basic BASE64_ENCODED_USER:PASSWORD